import time
import random
def insertion_sort(arr):
for i in range(1, len(arr)):
key = arr[i]
j = i - 1
while j >= 0 and arr[j] > key:
arr[j + 1] = arr[j]
j -= 1
arr[j + 1] = key
sizes = [10000, 25000, 50000, 100000]
for size in sizes:
arr = random.sample(range(1000000), size)
start = time.time()
insertion_sort(arr)
end = time.time()
print(f"Running time for Insertion Sort is {(end - start) * 1000:.2f} ms")
